# Gemini API key for AI architecture reasoning and optimization suggestions
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# SerpApi key for real-time pricing data search
# Get one at https://serpapi.com
SERPAPI_API_KEY=

# Nutrient DWS credentials for document generation, extraction, and viewing
# Get access at https://api.nutrient.io
NUTRIENT_DWS_USERNAME=
NUTRIENT_DWS_PASSWORD=
NUTRIENT_PROCESSOR_API_KEY=
NUTRIENT_DATA_EXTRACTION_API_KEY=
NUTRIENT_VIEWER_API_KEY=

# Xano backend API base URL (public — used by the frontend)
# Get yours from https://app.xano.com → your instance → API base URL
NEXT_PUBLIC_XANO_API_BASE=

# Doctavian API key for document generation and digital signatures
# Sponsor: Doctavian — Generate It Right. Sign It Tight. ($1,000 prize)
# Get yours from the Doctavian team after registering for the hackathon
DOCTAVIAN_API_KEY=
DOCTAVIAN_API_BASE=https://demo.api.doctavian.com
DOCTAVIAN_TEAM_NAME=
DOCTAVIAN_SENDER_NAME=CloudCost AI
DOCTAVIAN_SENDER_EMAIL=

# Doctavian OAuth (Microsoft device code flow — one-time setup)
# The defaults use Azure CLI's public client and the MSA consumers tenant.
# To authenticate: visit /api/auth/setup and follow the device code instructions.
# The refresh token is cached in .msal-cache/ and auto-renews — no manual refresh needed.
DOCTAVIAN_OAUTH_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46
DOCTAVIAN_OAUTH_TENANT_ID=9188040d-6c67-4c5b-b112-36a304b66dad
DOCTAVIAN_OAUTH_SCOPE=40728276-52a7-4932-bf32-76737f1fd01a/API.Access offline_access
